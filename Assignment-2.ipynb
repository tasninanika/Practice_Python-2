   "metadata": {},
   "source": [
    "# Sum all the odd numbers from 0 to 100 and print it to the screen."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cf7c86ea-8e8c-4312-8bba-7679f43a3dbf",
   "metadata": {},
   "source": [
    "# while loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "aace9a83-6f2c-4eed-aa6b-0e5b7d91121d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2500\n"
     ]
    }
   ],
   "source": [
    "total = 0\n",
    "num = 1\n",
    "while num <= 100:\n",
    "    total += num\n",
    "    num += 2\n",
    "    \n",
    "print(total)\n",
    "    "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9dde2a78-69c4-45a6-b391-0ea8e842b2b0",
   "metadata": {},
   "source": [
    "# for loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6af834fe-f1eb-4e62-8ebf-dd779765354b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2500\n"
     ]
    }
   ],
   "source": [
    "total = 0\n",
    "for i in range(1, 100, 2):\n",
    "    total += i\n",
    "print(total)  "
   ]
  }
 ],
